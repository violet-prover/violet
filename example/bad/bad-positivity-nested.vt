# `Box`'s parameter is inferred as Unrestricted because `A` appears under
# an arrow in `mk : (A -> A) -> Box A`. Placing `Rose A` in that
# Unrestricted slot therefore violates strict positivity.
\data Box (A : U) : U
  | mk : (A -> A) -> Box A

\data Rose (A : U) : U
  | node : Box (Rose A) -> Rose A
