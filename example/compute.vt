import nat
import list
import equality

let one : Nat := suc zero
let two : Nat := suc one

# Nat-elim ι-reduction
let z-plus-z : Id (add zero zero) zero := refl
let z-plus-one : Id (add zero one) one := refl
let two-plus-z : Id (add two zero) two := refl
let one-plus-one : Id (add one one) two := refl

# List-elim ι-reduction via a recursive length
let length-motive {A : U} (xs : List A) : U := Nat
let length-case-cons {A : U} (x : A) (rest : List A) (ih : Nat) : Nat := suc ih
let length {A : U} (xs : List A) : Nat :=
  List-elim
    A
    xs
    (length-motive {A})
    zero
    (length-case-cons {A})

let len-nil : Id (length {Nat} nil) zero := refl
let len-one : Id (length {Nat} (cons zero nil)) one := refl
