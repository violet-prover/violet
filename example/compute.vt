import nat
import list
import equality

let one : Nat := suc zero
let two : Nat := suc one

let z-plus-z : Id (add zero zero) zero := refl
let z-plus-one : Id (add zero one) one := refl
let two-plus-z : Id (add two zero) two := refl
let one-plus-one : Id (add one one) two := refl

let length {A : U} : (xs : List A) -> Nat where
  length A xs <= elim xs
  | length A nil => zero
  | length A (cons x xs) => suc (length A xs)

let len-nil : Id (length {Nat} nil) zero := refl
let len-one : Id (length {Nat} (cons zero nil)) one := refl
