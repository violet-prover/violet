\import std/nat
\import std/nat/properties
\import std/list
\import std/vec
\import std/id
\import std/sigma
\import std/sigma-multi
\import pterodactyl

\universe U

# whatever
\let id {A : U} (x : A) : A => x
\let id2 {B : U} (x : B) : B => id x

\let z : Nat => zero
\let s : Nat -> Nat => Nat/suc
\let one : Nat => Nat/suc zero
\let two : Nat => Nat/suc one
\let add1 (x : Nat) : Nat => Nat/suc x
\let eq-1 : Id (add1 zero) (Nat/suc zero) => refl
\let eq-0 : Id {Nat} zero zero => refl
\let eq-0-implicit : Id {Nat} zero zero => refl
\let eq-2 : Id (add one one) two => refl

# eliminator
\let motive (x : Nat) : U => Nat -> Nat
\let case-zero (y : Nat) : Nat => y
\let case-suc (x- : Nat) (add-x- : motive x-) (y : Nat) : Nat => Nat/suc (add-x- y)
\let eliminator-add (x : Nat) : Nat -> Nat =>
  Nat/elim
    x
    motive
    case-zero
    case-suc
