\import nat
\import equality

\universe U

\record Pair (A : U) (B : U) : U
  | fst : A
  | snd : B

\let p : Pair Nat Nat => { fst = Nat/zero, snd = Nat/suc Nat/zero }

# Surface eta test: rebuild p from its components and prove equality via refl.
# This exercises the kernel eta-expansion: q should be definitionally equal to p
# because Pair/fst Nat Nat p = p.fst and Pair/snd Nat Nat p = p.snd by beta-reduction,
# and eta says p = {fst = p.fst, snd = p.snd}.
#
# The unifier handles VRecordIntro vs Flex by solving the meta directly with the
# whole record literal rather than projecting fields from a flex (which would
# produce stuck neutrals).
\let q : Pair Nat Nat => { fst = Pair/fst Nat Nat p, snd = Pair/snd Nat Nat p }
\let eta-refl : Id q p => refl
