\import std/bool
\import std/sigma

\universe U

\export swap

# Identity in stack style — one `<= \intro`, one clause.
\let identity (A : U) : A -> A \where
  <= \intro
  | identity A x => x

# Boolean negation via `<= \split` on the intro'd argument.
\let neg : Bool -> Bool \where
  <= \intro
  <= \split
  | neg true => false
  | neg false => true

# Or we can use `neg2 b <= \elim b`
\let neg2 : Bool -> Bool \where
  neg2 b <= \elim b
  | neg2 true => false
  | neg2 false => true

# Sigma swap — record pattern on a Sigma pair binds `fst` and `snd`.
\let swap (A : U) (B : U) : Sigma A (\x -> B) -> Sigma B (\y -> A) \where
  <= \intro
  <= \split
  | swap A B { fst = a, snd = b } => { fst = b, snd = a }
