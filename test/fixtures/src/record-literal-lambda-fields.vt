\universe U

\data Id {A : U} (x : A) : A -> U
  | refl : Id x x

# Regression: a bare (unparenthesized) lambda as a non-final record-literal
# field value. Field values are parsed by the full `term` parser, which stops
# at the reserved separator `|` and at `}` — so the lambda body does not
# swallow the following `| field => ...` entries.
\record Equiv (A : U) (B : U) : U
  | to : A -> B
  | from : B -> A
  | sect : (b : B) -> Id {B} (to (from b)) b

\let id-equiv {A : U} : Equiv A A =>
  { to => \x -> x | from => \x -> x | sect => \b -> refl }
