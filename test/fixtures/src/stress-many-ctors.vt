\import std/nat
\import std/bool

\universe U

# Constructor enumeration plus an elim that pattern-matches each ctor.
# Stresses: ctor_outcomes generation, find_clause_for_ctor (linear scan
# over clauses per ctor → O(n²) total), motive construction across all
# arms, and the qualify_ctor_namespaces shadowing list construction.
