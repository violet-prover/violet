\import std/nat
\import std/id

\universe U V

\data Term : U -> U ⊔ V
  | eta : (n : Nat) -> Term Nat
  | add : Term Nat -> Term Nat -> Term Nat
  | mul : Term Nat -> Term Nat -> Term Nat

\data StackShape : U
  | empty : StackShape
  | cons : U -> StackShape -> StackShape

\operator "\x ◁ \s" => StackShape/cons x s
  \associativity: \right

\data Instr : StackShape -> StackShape -> U
  | PUSH : {s : StackShape} -> Nat -> Instr s (Nat ◁ s)
  | ADD  : {s : StackShape} -> Instr (Nat ◁ Nat ◁ s) (Nat ◁ s)
  | MUL  : {s : StackShape} -> Instr (Nat ◁ Nat ◁ s) (Nat ◁ s)

\data Prog : StackShape -> StackShape -> U
  | nil  : {s : StackShape} -> Prog s s
  | cons : {s1 s2 s3 : StackShape} -> Instr s1 s2 -> Prog s2 s3 -> Prog s1 s3

\data Stack : StackShape -> U
  | nil  : Stack StackShape/empty
  | cons : {s : StackShape} -> Nat -> Stack s -> Stack (Nat ◁ s)

\let exec-instr {s1 s2 : StackShape}
  : (i : Instr s1 s2) -> (stk : Stack s1) -> Stack s2 \where
  exec-instr i stk <= \elim i
  | exec-instr (PUSH n) stk => Stack/cons n stk
  | exec-instr ADD stk <= \elim stk
  | exec-instr ADD (cons n1 stk) <= \elim stk
  | exec-instr ADD (cons n1 (cons n2 stk)) => Stack/cons (add n1 n2) stk
  | exec-instr MUL stk <= \elim stk
  | exec-instr MUL (cons n1 stk) => ?mul
