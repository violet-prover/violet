\universe U

# The recursive use of `Tree` passes `A -> A` to its parameter slot
# instead of the declared param `A`, violating the uniform-recursion
# rule. (`leaf` is included only to give `Tree` a base case; `node`
# alone would trigger the same rejection.)
\data Tree (A : U) : U
  | leaf : Tree A
  | node : Tree (A -> A) -> Tree A
