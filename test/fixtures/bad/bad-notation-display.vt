# Pretty printing must prefer user-defined operator notation: the unify
# error below renders `Id z z` as `z = z`, with the raw form in a
# trailing `(i.e. …)`.

\universe U

\data Nat : U
  | zero : Nat
  | suc : Nat -> Nat

\data Id {A : U} (x : A) : A -> U
  | refl : Id x x

\operator "\x = \y" => Id x y
  \associativity: \left

\let z : Nat => zero

\let bad : (z = z) -> Nat => \p -> p
