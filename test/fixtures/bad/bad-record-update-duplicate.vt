\import std/nat

\universe U

\record Point : U
  | x : Nat
  | y : Nat

\let p : Point => { x = Nat/zero, y = Nat/zero }

# Same field overridden twice — the update has a duplicate field.
# Mirrors bad-record-duplicate-field.vt for the *update* path.
\let bad : Point => { p | x = Nat/suc Nat/zero, x = Nat/suc (Nat/suc Nat/zero) }
