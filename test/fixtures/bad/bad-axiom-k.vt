# Axiom K must not be provable - Violet is HoTT-compatible (no K/UIP).
# The eliminator rejects matching on `refl : Id a a` because the two
# indices cannot be independently generalized.

\import std/id

\universe U

\let K {A : U} (a : A) (P : a = a -> U) : (p : P refl) -> (e : a = a) -> P e \where
  K a P p e <= \elim e
  | K a P p refl => p
