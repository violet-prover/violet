compiler-goals/?add-step-1
  --- context ---
  x : ImplementedNat
  y : ImplementedNat
  σ : StackShape
  stk : Stack σ
  --- target ---
  (exec ((y.prog) ⍮* ((x.prog) ⍮* (ADD ⍮ empty))) stk) = (exec ((x.prog) ⍮* (ADD ⍮ empty)) (exec (y.prog) stk)) (i.e. Id (exec (concat-program (y.prog) (concat-program (x.prog) (prepend ADD empty))) stk) (exec (concat-program (x.prog) (prepend ADD empty)) (exec (y.prog) stk)))

43:12-43:23
compiler-goals/?add-step-3
  --- context ---
  x : ImplementedNat
  y : ImplementedNat
  σ : StackShape
  stk : Stack σ
  --- target ---
  (exec (ADD ⍮ empty) (exec (x.prog) (exec (y.prog) stk))) = (exec (ADD ⍮ empty) (exec (x.prog) (cons (y.value) stk))) (i.e. Id (exec (prepend ADD empty) (exec (x.prog) (exec (y.prog) stk))) (exec (prepend ADD empty) (exec (x.prog) (cons (y.value) stk))))

