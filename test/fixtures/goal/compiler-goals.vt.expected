compiler-goals/?literal-ok
  --- context ---
  n : Nat
  σ : StackShape
  stk : Stack σ
  --- target ---
  (exec ((PUSH n) ⍮ empty) stk) = (cons n stk) (i.e. Id (exec (prepend (PUSH n) empty) stk) (cons n stk))

