54:21-54:28
compiler-goals/?mul-ok
  --- context ---
  x : ImplementedNat
  y : ImplementedNat
  σ : StackShape
  stk : Stack σ
  --- target ---
  (exec ((y.prog) ⍮* ((x.prog) ⍮* (MUL ⍮ empty))) stk) = (cons ((x.value) * (y.value)) stk) (i.e. Id (exec (concat-program (y.prog) (concat-program (x.prog) (prepend MUL empty))) stk) (cons (mul (x.value) (y.value)) stk))

