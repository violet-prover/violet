license: "LICENSE"
homepage: "https://violet-lang.org"
doc: "https://violet-lang.org"
bug-reports: "https://codeberg.org/dannypsnl/violet/issues"
depends: [
  "ocaml" {>= "5.3"}
  "dune" {>= "3.17"}
  "ppx_deriving"
  "ppx_expect"
  "asai"
  "algaeff"
  "yuujinchou"
  "bwd"
  "eio"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
